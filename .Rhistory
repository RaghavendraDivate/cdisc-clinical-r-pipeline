# ==============================================================================
# PROGRAM NAME:   05_documentation_and_summary.R (Refined Formatting)
# PROJECT:        CDISC Pilot Study 01 (ADAS-Cog Analysis)
# DESCRIPTION:    Cleans NaN values, merges repeated visit rows, and exports
#                 a publication-grade Table 4 to Word.
# AUTHOR:         Raghavendra Ramesh Divate
# DATE:           2026-09-01
# INPUT DATA:     adsl, adadas
# OUTPUT DATA:    Table_4_Summary_Statistics.docx, Pipeline_Documentation.md
# DEPENDENCIES:   dplyr, flextable, officer
# ==============================================================================
library(dplyr)
library(flextable)
library(officer)
# ------------------------------------------------------------------------------
# STEP 1: CALCULATE SUMMARY & CLEAN STRING FORMATTING
# ------------------------------------------------------------------------------
table4_clean <- adadas %>%
filter(
ITTFL == "Y",
PARAMCD == "ACTOT",
ANL01FL == "Y",
AVISIT %in% c("Baseline", "Week 8", "Week 16", "Week 24")
) %>%
inner_join(
adsl %>% filter(ITTFL == "Y") %>% select(USUBJID, TRT01P),
by = "USUBJID"
) %>%
group_by(AVISIT, TRT01P) %>%
summarise(
N         = n(),
Mean_AVAL = mean(AVAL, na.rm = TRUE),
SD_AVAL   = sd(AVAL, na.rm = TRUE),
Median_AV = median(AVAL, na.rm = TRUE),
Min_AVAL  = min(AVAL, na.rm = TRUE),
Max_AVAL  = max(AVAL, na.rm = TRUE),
Mean_CHG  = mean(CHG, na.rm = TRUE),
SD_CHG    = sd(CHG, na.rm = TRUE),
.groups   = "drop"
) %>%
mutate(AVISIT = factor(AVISIT, levels = c("Baseline", "Week 8", "Week 16", "Week 24"))) %>%
arrange(AVISIT, TRT01P) %>%
# Fix NaN string conversions explicitly
mutate(
Score_Formatted  = sprintf("%.1f (%.2f)", Mean_AVAL, SD_AVAL),
Median_Formatted = sprintf("%.1f", Median_AV),
Range_Formatted  = sprintf("%.1f, %.1f", Min_AVAL, Max_AVAL),
Change_Formatted = ifelse(
AVISIT == "Baseline" | is.na(Mean_CHG),
"—",  # Standard clinical reporting symbol for Not Applicable / Baseline Change
sprintf("%.1f (%.2f)", Mean_CHG, SD_CHG)
)
) %>%
select(
AVISIT,
TRT01P,
N,
Score_Formatted,
Median_Formatted,
Range_Formatted,
Change_Formatted
)
# ------------------------------------------------------------------------------
# STEP 2: BUILD PUBLICATION-GRADE FLEXTABLE
# ------------------------------------------------------------------------------
ft4 <- flextable(table4_clean) %>%
# Merge duplicate Visit cells vertically for a clean layout
merge_v(j = "AVISIT") %>%
set_header_labels(
AVISIT           = "Visit",
TRT01P           = "Treatment Arm",
N                = "N",
Score_Formatted  = "Score: Mean (SD)",
Median_Formatted = "Median",
Range_Formatted  = "Min, Max",
Change_Formatted = "Change: Mean (SD)"
) %>%
# Align text left, numbers center/right
align(j = c("AVISIT", "TRT01P"), align = "left", part = "all") %>%
align(j = c("N", "Score_Formatted", "Median_Formatted", "Range_Formatted", "Change_Formatted"), align = "center", part = "all") %>%
# Add subtle padding and borders
valign(j = "AVISIT", valign = "top") %>%
autofit() %>%
theme_booktabs() %>%
add_header_lines("Table 4: Summary of ADAS-Cog Total Score by Visit (ITT Population)")
# ------------------------------------------------------------------------------
# STEP 3: EXPORT TO WORD
# ------------------------------------------------------------------------------
doc <- read_docx() %>% body_add_flextable(ft4)
print(doc, target = "Table_4_Summary_Statistics.docx")
cat("Success: Refined Table 4 generated without NaN values!\n")
