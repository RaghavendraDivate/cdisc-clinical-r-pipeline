.groups   = "drop"
) %>%
mutate(AVISIT = factor(AVISIT, levels = c("Baseline", "Week 8", "Week 16", "Week 24"))) %>%
arrange(AVISIT, TRT01P)
# Render formatted Flextable
ft4 <- flextable(table4_data) %>%
